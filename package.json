{
  "name": "bayesforce",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.23.0",
  "scripts": {
    "start": "pnpm --filter @bayesforce/landing dev",
    "start:win": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\start-local.ps1",
    "stop:win": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\start-local.ps1 stop",
    "status:win": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\start-local.ps1 status",
    "dev": "pnpm --filter @bayesforce/landing dev",
    "build": "pnpm --filter @bayesforce/landing build",
    "typecheck": "pnpm --filter @bayesforce/landing typecheck"
  }
}
